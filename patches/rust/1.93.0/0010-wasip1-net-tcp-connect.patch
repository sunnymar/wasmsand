+type CodepodSaFamily = u16;
+type CodepodInPort = u16;
+type CodepodInAddrRaw = u32;
+type CodepodSockLen = u32;
+
+const CODEPOD_AF_INET: i32 = 1;
+const CODEPOD_SOCK_STREAM: i32 = 6;
+
+#[repr(C, align(16))]
+struct CodepodSockAddr {
+    sa_family: CodepodSaFamily,
+    sa_data: [i8; 0],
+}
+
+#[repr(C)]
+struct CodepodInAddr {
+    s_addr: CodepodInAddrRaw,
+}
+
+#[repr(C, align(16))]
+struct CodepodSockAddrIn {
+    sin_family: CodepodSaFamily,
+    sin_port: CodepodInPort,
+    sin_addr: CodepodInAddr,
+}
+
+unsafe extern "C" {
+    fn socket(domain: i32, socket_type: i32, protocol: i32) -> i32;
+    fn connect(fd: i32, addr: *const CodepodSockAddr, addr_len: CodepodSockLen) -> i32;
+    fn close(fd: i32) -> i32;
+}
+
+fn tcp_connect_addr(addr: &SocketAddr) -> io::Result<TcpStream> {
+    let SocketAddr::V4(addr) = addr else {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "IPv6 sockets are not supported by Codepod wasm32-wasip1 yet",
+        ));
+    };
+
+    let fd = unsafe { socket(CODEPOD_AF_INET, CODEPOD_SOCK_STREAM, 0) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+
+    let raw = CodepodSockAddrIn {
+        sin_family: CODEPOD_AF_INET as CodepodSaFamily,
+        sin_port: addr.port().to_be(),
+        sin_addr: CodepodInAddr {
+            s_addr: u32::from_ne_bytes(addr.ip().octets()),
+        },
+    };
+
+    let rc = unsafe {
+        connect(
+            fd,
+            &raw as *const CodepodSockAddrIn as *const CodepodSockAddr,
+            mem::size_of::<CodepodSockAddrIn>() as CodepodSockLen,
+        )
+    };
+    if rc != 0 {
+        let err = io::Error::last_os_error();
+        unsafe { close(fd) };
+        return Err(err);
+    }
+
+    Ok(TcpStream { inner: unsafe { Socket::from_raw_fd(fd as RawFd) } })
+}
