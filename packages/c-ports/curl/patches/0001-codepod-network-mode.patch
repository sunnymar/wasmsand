@@ -1074,0 +1076,16 @@ static ParameterError set_rate(const char *nextarg)
+static ParameterError parse_codepod_network(struct OperationConfig *config,
+                                            const char *nextarg)
+{
+  if(curl_strequal(nextarg, "auto"))
+    config->codepod_network = CURLCODEPOD_NETWORK_AUTO;
+  else if(curl_strequal(nextarg, "fetch"))
+    config->codepod_network = CURLCODEPOD_NETWORK_FETCH;
+  else if(curl_strequal(nextarg, "socket"))
+    config->codepod_network = CURLCODEPOD_NETWORK_SOCKET;
+  else {
+    errorf("--codepod-network must be auto, fetch, or socket");
+    return PARAM_BAD_USE;
+  }
+  return PARAM_OK;
+}
+
