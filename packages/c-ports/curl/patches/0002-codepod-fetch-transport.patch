+__attribute__((import_module("codepod"), import_name("host_network_fetch")))
+int codepod_host_network_fetch(int req_ptr, int req_len,
+                               int out_ptr, int out_cap);
+
+#define CODEPOD_FETCH_REQ_MAX 65536
+#define CODEPOD_FETCH_RESP_INITIAL 65536
+
+static CURLcode codepod_dyn_add_json_string(struct dynbuf *b,
+                                            const char *value)
+{
+  const unsigned char *p = (const unsigned char *)(value ? value : "");
+  CURLcode result = curlx_dyn_addn(b, STRCONST("\""));
+  if(result)
+    return result;
+
+  for(; *p; p++) {
+    switch(*p) {
+    case '\\':
+      result = curlx_dyn_addn(b, STRCONST("\\\\"));
+      break;
+    case '"':
+      result = curlx_dyn_addn(b, STRCONST("\\\""));
+      break;
+    case '\n':
+      result = curlx_dyn_addn(b, STRCONST("\\n"));
+      break;
+    case '\r':
+      result = curlx_dyn_addn(b, STRCONST("\\r"));
+      break;
+    case '\t':
+      result = curlx_dyn_addn(b, STRCONST("\\t"));
+      break;
+    default:
+      if(*p < 0x20)
+        return CURLE_BAD_FUNCTION_ARGUMENT;
+      result = curlx_dyn_addn(b, (const char *)p, 1);
+      break;
+    }
+    if(result)
+      return result;
+  }
+  return curlx_dyn_addn(b, STRCONST("\""));
+}
+
+static const char *codepod_json_field(const char *json, size_t json_len,
+                                      const char *name)
+{
+  char needle[64];
+  int n = snprintf(needle, sizeof(needle), "\"%s\":", name);
+  size_t needle_len;
+
+  if(n <= 0 || (size_t)n >= sizeof(needle))
+    return NULL;
+  needle_len = (size_t)n;
+  for(size_t i = 0; i + needle_len <= json_len; i++) {
+    if(!memcmp(json + i, needle, needle_len))
+      return json + i + needle_len;
+  }
+  return NULL;
+}
+
+static char codepod_json_unescape_char(char ch)
+{
+  switch(ch) {
+  case 'n':
+    return '\n';
+  case 'r':
+    return '\r';
+  case 't':
+    return '\t';
+  case 'b':
+    return '\b';
+  case 'f':
+    return '\f';
+  default:
+    return ch;
+  }
+}
+
+static CURLcode codepod_json_dup_string_at(const char *p, const char *end,
+                                           char **out, const char **after)
+{
+  struct dynbuf b;
+  CURLcode result = CURLE_OK;
+
+  *out = NULL;
+  while(p < end && ISBLANK(*p))
+    p++;
+  if(p >= end || *p != '"')
+    return CURLE_RECV_ERROR;
+  p++;
+
+  curlx_dyn_init(&b, DYN_HTTP_REQUEST);
+  while(p < end) {
+    char ch = *p++;
+    if(ch == '"') {
+      *out = curlx_dyn_ptr(&b) ? curlx_strdup(curlx_dyn_ptr(&b)) :
+        curlx_strdup("");
+      if(after)
+        *after = p;
+      curlx_dyn_free(&b);
+      return *out ? CURLE_OK : CURLE_OUT_OF_MEMORY;
+    }
+    if(ch == '\\') {
+      if(p >= end) {
+        result = CURLE_RECV_ERROR;
+        break;
+      }
+      ch = *p++;
+      if(ch == 'u') {
+        result = CURLE_RECV_ERROR;
+        break;
+      }
+      ch = codepod_json_unescape_char(ch);
+    }
+    result = curlx_dyn_addn(&b, &ch, 1);
+    if(result)
+      break;
+  }
+  curlx_dyn_free(&b);
+  return result ? result : CURLE_RECV_ERROR;
+}
+
+static CURLcode codepod_json_dup_string_field(const char *json,
+                                              size_t json_len,
+                                              const char *name,
+                                              char **out)
+{
+  const char *p = codepod_json_field(json, json_len, name);
+  const char *end = json + json_len;
+
+  *out = NULL;
+  if(!p)
+    return CURLE_OK;
+  while(p < end && ISBLANK(*p))
+    p++;
+  if((size_t)(end - p) >= 4 && !memcmp(p, "null", 4))
+    return CURLE_OK;
+  return codepod_json_dup_string_at(p, end, out, NULL);
+}
+
+static CURLcode codepod_json_int_field(const char *json, size_t json_len,
+                                       const char *name, int *out)
+{
+  const char *p = codepod_json_field(json, json_len, name);
+  const char *end = json + json_len;
+  curl_off_t value;
+  int rc;
+
+  if(!p)
+    return CURLE_RECV_ERROR;
+  while(p < end && ISBLANK(*p))
+    p++;
+  rc = curlx_str_number(&p, &value, 999);
+  if(rc)
+    return CURLE_RECV_ERROR;
+  *out = (int)value;
+  return CURLE_OK;
+}
+
+static CURLcode codepod_fetch_add_headers_json(struct dynbuf *json,
+                                               const char *req,
+                                               size_t req_len)
+{
+  const char *p = memchr(req, '\n', req_len);
+  bool first = TRUE;
+  CURLcode result = curlx_dyn_addn(json, STRCONST("{"));
+
+  if(result)
+    return result;
+  if(!p)
+    return curlx_dyn_addn(json, STRCONST("}"));
+  p++;
+
+  while(p < req + req_len) {
+    const char *line_end = memchr(p, '\n', (size_t)((req + req_len) - p));
+    const char *colon;
+    size_t line_len;
+    size_t name_len;
+    const char *value;
+    size_t value_len;
+    char *name;
+    char *val;
+
+    if(!line_end)
+      break;
+    line_len = (size_t)(line_end - p);
+    if(line_len && p[line_len - 1] == '\r')
+      line_len--;
+    if(!line_len)
+      break;
+    colon = memchr(p, ':', line_len);
+    if(!colon) {
+      p = line_end + 1;
+      continue;
+    }
+    name_len = (size_t)(colon - p);
+    value = colon + 1;
+    while(name_len && ISBLANK(p[name_len - 1]))
+      name_len--;
+    while(value < p + line_len && ISBLANK(*value))
+      value++;
+    value_len = (size_t)((p + line_len) - value);
+    while(value_len && ISBLANK(value[value_len - 1]))
+      value_len--;
+
+    name = curlx_memdup0(p, name_len);
+    val = curlx_memdup0(value, value_len);
+    if(!name || !val) {
+      curlx_free(name);
+      curlx_free(val);
+      return CURLE_OUT_OF_MEMORY;
+    }
+    result = first ? CURLE_OK : curlx_dyn_addn(json, STRCONST(","));
+    first = FALSE;
+    if(!result)
+      result = codepod_dyn_add_json_string(json, name);
+    if(!result)
+      result = curlx_dyn_addn(json, STRCONST(":"));
+    if(!result)
+      result = codepod_dyn_add_json_string(json, val);
+    curlx_free(name);
+    curlx_free(val);
+    if(result)
+      return result;
+    p = line_end + 1;
+  }
+  return curlx_dyn_addn(json, STRCONST("}"));
+}
+
+static CURLcode codepod_fetch_build_request(struct Curl_easy *data,
+                                            const char *method,
+                                            const struct dynbuf *req,
+                                            struct dynbuf *json)
+{
+  const char *url = Curl_bufref_ptr(&data->state.url);
+  CURLcode result = curlx_dyn_addn(json, STRCONST("{\"url\":"));
+
+  if(!result)
+    result = codepod_dyn_add_json_string(json, url);
+  if(!result)
+    result = curlx_dyn_addn(json, STRCONST(",\"method\":"));
+  if(!result)
+    result = codepod_dyn_add_json_string(json, method);
+  if(!result)
+    result = curlx_dyn_addn(json, STRCONST(",\"headers\":"));
+  if(!result)
+    result = codepod_fetch_add_headers_json(json, curlx_dyn_ptr(req),
+                                            curlx_dyn_len(req));
+  if(!result && data->set.postfields) {
+    result = curlx_dyn_addn(json, STRCONST(",\"body\":"));
+    if(!result)
+      result = codepod_dyn_add_json_string(json,
+                                           (const char *)data->set.postfields);
+  }
+  if(!result)
+    result = curlx_dyn_addn(json, STRCONST(",\"redirect\":\"manual\"}"));
+  return result;
+}
+
+static CURLcode codepod_fetch_call(const char *req, size_t req_len,
+                                   char **out, size_t *out_len)
+{
+  int cap = CODEPOD_FETCH_RESP_INITIAL;
+  char *buf;
+  int written;
+
+  *out = NULL;
+  *out_len = 0;
+  if(req_len > CODEPOD_FETCH_REQ_MAX)
+    return CURLE_TOO_LARGE;
+
+  buf = curlx_malloc((size_t)cap + 1);
+  if(!buf)
+    return CURLE_OUT_OF_MEMORY;
+
+  for(;;) {
+    written = codepod_host_network_fetch((int)(uintptr_t)req, (int)req_len,
+                                         (int)(uintptr_t)buf, cap);
+    if(written < 0) {
+      curlx_free(buf);
+      return CURLE_COULDNT_CONNECT;
+    }
+    if(written < cap) {
+      buf[written] = '\0';
+      *out = buf;
+      *out_len = (size_t)written;
+      return CURLE_OK;
+    }
+    cap = written + 1;
+    buf = curlx_realloc(buf, (size_t)cap + 1);
+    if(!buf)
+      return CURLE_OUT_OF_MEMORY;
+  }
+}
+
+static CURLcode codepod_fetch_write_header_line(struct Curl_easy *data,
+                                                const char *name,
+                                                const char *value)
+{
+  char *line = curl_maprintf("%s: %s\r\n", name, value ? value : "");
+  CURLcode result;
+
+  if(!line)
+    return CURLE_OUT_OF_MEMORY;
+  result = Curl_http_write_resp_hd(data, line, strlen(line), FALSE);
+  curlx_free(line);
+  return result;
+}
+
+static CURLcode codepod_fetch_write_headers_object(struct Curl_easy *data,
+                                                   const char *json,
+                                                   size_t json_len)
+{
+  const char *p = codepod_json_field(json, json_len, "headers");
+  const char *end = json + json_len;
+  CURLcode result = CURLE_OK;
+
+  if(!p)
+    return CURLE_OK;
+  while(p < end && ISBLANK(*p))
+    p++;
+  if(p >= end || *p != '{')
+    return CURLE_OK;
+  p++;
+  while(p < end) {
+    char *name = NULL;
+    char *value = NULL;
+
+    while(p < end && (ISBLANK(*p) || *p == ','))
+      p++;
+    if(p >= end || *p == '}')
+      break;
+    result = codepod_json_dup_string_at(p, end, &name, &p);
+    if(!result) {
+      while(p < end && (ISBLANK(*p) || *p == ':'))
+        p++;
+      result = codepod_json_dup_string_at(p, end, &value, &p);
+    }
+    if(!result)
+      result = codepod_fetch_write_header_line(data, name, value);
+    curlx_free(name);
+    curlx_free(value);
+    if(result)
+      return result;
+    while(p < end && *p != ',' && *p != '}')
+      p++;
+  }
+  return CURLE_OK;
+}
+
+bool Curl_codepod_fetch_should_use(struct Curl_easy *data)
+{
+  long mode = Curl_codepod_network_mode(data);
+  const char *url;
+
+  if(mode == CURLCODEPOD_NETWORK_FETCH)
+    return TRUE;
+  if(mode == CURLCODEPOD_NETWORK_SOCKET)
+    return FALSE;
+
+  url = Curl_bufref_ptr(&data->state.url);
+  return url && curl_strnequal(url, "https://", 8);
 }

+static CURLcode Curl_codepod_fetch_perform(struct Curl_easy *data,
+                                           const char *method,
+                                           const struct dynbuf *req)
+{
+  struct dynbuf json;
+  char *resp = NULL;
+  size_t resp_len = 0;
+  char *error = NULL;
+  char *body64 = NULL;
+  uint8_t *body = NULL;
+  size_t body_len = 0;
+  int status = 0;
+  CURLcode result;
+  char *statusline;
+
+  curlx_dyn_init(&json, DYN_HTTP_REQUEST);
+  result = codepod_fetch_build_request(data, method, req, &json);
+  if(result)
+    goto out;
+
+  result = codepod_fetch_call(curlx_dyn_ptr(&json), curlx_dyn_len(&json),
+                              &resp, &resp_len);
+  if(result)
+    goto out;
+
+  result = codepod_json_dup_string_field(resp, resp_len, "error", &error);
+  if(result)
+    goto out;
+  if(error) {
+    failf(data, "Codepod fetch failed: %s", error);
+    result = CURLE_COULDNT_CONNECT;
+    goto out;
+  }
+
+  result = codepod_json_int_field(resp, resp_len, "status", &status);
+  if(result)
+    goto out;
+
+  data->req.header = TRUE;
+  data->req.httpcode = status;
+  data->info.httpcode = status;
+  data->req.httpversion = 11;
+  statusline = curl_maprintf("HTTP/1.1 %03d Codepod Fetch\r\n", status);
+  if(!statusline) {
+    result = CURLE_OUT_OF_MEMORY;
+    goto out;
+  }
+  result = Curl_http_write_resp_hd(data, statusline, strlen(statusline),
+                                   FALSE);
+  curlx_free(statusline);
+  if(result)
+    goto out;
+
+  result = codepod_fetch_write_headers_object(data, resp, resp_len);
+  if(result)
+    goto out;
+  result = Curl_http_write_resp_hd(data, "\r\n", 2, FALSE);
+  if(result)
+    goto out;
+
+  result = codepod_json_dup_string_field(resp, resp_len, "body_base64",
+                                         &body64);
+  if(result)
+    goto out;
+  if(body64 && body64[0])
+    result = curlx_base64_decode(body64, &body, &body_len);
+  else {
+    char *text = NULL;
+    if(!body64) {
+      result = codepod_json_dup_string_field(resp, resp_len, "body", &text);
+      if(result)
+        goto out;
+      if(text) {
+        body = (uint8_t *)text;
+        body_len = strlen(text);
+      }
+    }
+  }
+  if(result)
+    goto out;
+
+  result = Curl_client_write(data, CLIENTWRITE_BODY | CLIENTWRITE_EOS,
+                             (const char *)(body ? body : (uint8_t *)""),
+                             data->req.no_body ? 0 : body_len);
+  if(result)
+    goto out;
+
+  data->req.upload_done = TRUE;
+  data->req.download_done = TRUE;
+  data->req.eos_written = TRUE;
+  data->req.done = TRUE;
+  data->req.keepon = KEEP_NONE;
+  data->conn->recv_idx = -1;
+  data->conn->send_idx = -1;
+
+out:
+  curlx_dyn_free(&json);
+  curlx_free(resp);
+  curlx_free(error);
+  curlx_free(body64);
+  curlx_free(body);
+  return result;
+}
